{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#6272a4",
          "foreground": "#f8f8f2",
          "leading_diamond": "\ue0b6",
          "style": "diamond",
          "template": "{{ .UserName }} ",
          "type": "session"
        },
        {
          "background": "#bd93f9",
          "foreground": "#f8f8f2",
          "powerline_symbol": "\ue0b0",
          "options": {
            "folder_icon": "..\ue5fe..",
            "home_icon": "~",
            "style": "full"
          },
          "style": "powerline",
          "template": " {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#ffb86c",
          "foreground": "#494D64",
          "powerline_symbol": "\ue0b0",
          "options": {
            "branch_icon": "\ue725 ",
            "cherry_pick_icon": "\ue29b ",
            "commit_icon": "\uf417 ",
            "fetch_status": false,
            "fetch_upstream_icon": false,
            "merge_icon": "\ue727 ",
            "no_commits_icon": "\uf0c3 ",
            "rebase_icon": "\ue728 ",
            "revert_icon": "\uf0e2 ",
            "tag_icon": "\uf412 "
          },
          "style": "powerline",
          "template": " \ue725 ({{ .UpstreamIcon }}{{ .HEAD }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }}) ",
          "type": "git"
        },
        {
          "background": "#ff79c6",
          "foreground": "#f8f8f2",
          "options": {
            "time_format": "15:04"
          },
          "style": "diamond",
          "template": " \u2665 {{ .CurrentDate | date .Format }} ",
          "trailing_diamond": "\ue0b0",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "type": "kubectl",
          "style": "diamond",
          "leading_diamond": "\ue0b2",
          "trailing_diamond": "",
          "foreground": "#FFFFFF",
          "background": "#4770DE",
          "template": " 󱃾 {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}} ",
          "options": {
            "context_aliases": {
              "arn:aws:eks:us-east-1:557690603200:cluster/rpt-dev": "rpt-dev",
              "arn:aws:eks:us-east-1:557690603200:cluster/rpt-demo": "rpt-demo"
            }
          }
        },
        {
          "type": "terraform",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#81ff91",
          "template": "<#cc7eda> \u007C </><#7eb8da>\ue71e </> {{.WorkspaceName}}"
        },
        {
          "background": "#759F69",
          "foreground": "#F4F8EE",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \ued0d {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "type": "node"
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#ffd43b",
          "background": "#306998",
          "options": {
            "display_mode": "always"
          },
          "template": " \ue73c {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} "
        },
        {
          "background": "#cecece",
          "foreground": "#4b4b4b",
          "trailing_diamond": "\ue0b4",
          "options": {
            "style": "austin",
            "threshold": 150,
            "always_enabled": true
          },
          "style": "diamond",
          "template": " \uf017 {{ .FormattedMs }}",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#cd5e42",
          "style": "plain",
          "template": "\ue3bf ",
          "type": "root"
        },
        {
          "foreground": "#CD4277",
          "style": "plain",
          "template": "<#F5BDE6>\u276f</>",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],

  "transient_prompt": {
    "background": "transparent",
    "foreground": "#FEF5ED",
    "template": "<#F5BDE6>\u276f </>"
  },
  "final_space": true,
  "version": 3
}
