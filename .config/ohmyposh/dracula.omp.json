{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#bd93f9",
          "foreground": "#E9EDF5",
          "leading_diamond": "",
          "trailing_diamond": "",
          "options": {
            "folder_icon": "....",
            "home_icon": "~",
            "style": "full"
          },
          "style": "diamond",
          "template": "{{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#1C63C7",
          "foreground": "#E9EDF5",
          "trailing_diamond": "",
          "style": "diamond",
          "options": {
            "branch_icon": "  ",
            "cherry_pick_icon": "  ",
            "commit_icon": " ",
            "merge_icon": " ",
            "no_commits_icon": " ",
            "rebase_icon": " ",
            "revert_icon": " ",
            "tag_icon": " "
          },
          "template": "{{ .HEAD }}{{ if gt .Ahead 0 }} ⇡{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ⇣{{ .Behind }}{{ end }} ",
          "type": "git"
        },
        {
          "background": "#ff79c6",
          "foreground": "#E9EDF5",
          "options": {
            "time_format": "15:04 MST"
          },
          "trailing_diamond": "",
          "style": "diamond",
          "template": " ♥ {{ .CurrentDate | date .Format }}",
          "type": "time"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "type": "kubectl",
          "style": "powerline",
          "leading_powerline_symbol": "",
          "foreground": "#FFFFFF",
          "background": "#4770DE",
          "template": "󱃾 {{.Context}}{{if .Namespace}} :: {{.Namespace}}{{end}} ",
          "options": {
            "context_aliases": {
              "arn:aws:eks:us-east-1:557690603200:cluster/rpt-dev": "rpt-dev",
              "arn:aws:eks:us-east-1:557690603200:cluster/rpt-demo": "rpt-demo"
            }
          }
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#ffd43b",
          "background": "#306998",
          "options": {
            "display_mode": "always"
          },
          "template": "  {{ if .Error }}{{ .Error }}{{ else }}{{ if .Venv }}{{ .Venv }} {{ end }}{{ .Full }}{{ end }} "
        },
        {
          "background": "#cecece",
          "foreground": "#4b4b4b",
          "trailing_diamond": "",
          "options": {
            "style": "austin",
            "threshold": 150
          },
          "style": "diamond",
          "template": "  {{ .FormattedMs }}",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#cd5e42",
          "style": "plain",
          "template": " ",
          "type": "root"
        },
        {
          "foreground": "#CD4277",
          "style": "plain",
          "template": "<#F5BDE6>❯</>",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "transient_prompt": {
    "background": "transparent",
    "foreground": "#FEF5ED",
    "template": "<#F5BDE6>❯ </>"
  },
  "final_space": true,
  "version": 3
}
